# ── 프로바이더 선택 ──────────────────────────────────────────────
# claudecode : Claude Code CLI 사용 (별도 API 키 불필요, Pro 구독 활용)
# openai     : OpenAI GPT-4o / Codex API
# anthropic  : Anthropic Claude API
INFRADX_PROVIDER=claudecode

# ── Claude Code CLI (API 키 불필요) ─────────────────────────────
# claude CLI가 설치되어 로그인된 상태여야 합니다.
# INFRADX_PROVIDER=claudecode

# ── OpenAI (GPT-4o / Codex) ─────────────────────────────────────
# platform.openai.com 에서 발급
# INFRADX_PROVIDER=openai
# OPENAI_API_KEY=sk-your-openai-key-here
# INFRADX_MODEL=gpt-4o

# ── Anthropic (Claude) ───────────────────────────────────────────
# console.anthropic.com 에서 발급 (Claude Code Pro 구독과 별개)
# INFRADX_PROVIDER=anthropic
# ANTHROPIC_API_KEY=sk-ant-your-key-here
# INFRADX_MODEL=claude-sonnet-4-6

# ── 선택적 설정 ──────────────────────────────────────────────────
# INFRADX_DB_PATH=~/.local/share/infradx/sessions.db
