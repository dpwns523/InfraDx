# ── 프로바이더 선택 ──────────────────────────────────────────────
# openai (GPT-4o / Codex) 또는 anthropic (Claude) 중 하나를 선택
INFRADX_PROVIDER=openai

# ── OpenAI (GPT-4o / Codex) — primary ───────────────────────────
# platform.openai.com 에서 발급
OPENAI_API_KEY=sk-your-openai-key-here
INFRADX_MODEL=gpt-4o

# ── Anthropic (Claude) — secondary ──────────────────────────────
# console.anthropic.com 에서 발급 (Claude Code Pro 구독과 별개)
# INFRADX_PROVIDER=anthropic
# ANTHROPIC_API_KEY=sk-ant-your-key-here
# INFRADX_MODEL=claude-sonnet-4-6

# ── 선택적 설정 ──────────────────────────────────────────────────
# INFRADX_DB_PATH=~/.local/share/infradx/sessions.db
